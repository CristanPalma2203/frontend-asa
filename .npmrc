# npm 10 (el de Node 22) y npm 11 resuelven distinto las peer dependencies opcionales
# (@emnapi/*, ajv de @hookform/resolvers) y cada uno rechaza en `npm ci` el lockfile del otro.
# Sin resolución automática de peers, ambos validan el mismo árbol. Las peers obligatorias
# van declaradas explícitamente en package.json (p. ej. @testing-library/dom).
legacy-peer-deps=true
